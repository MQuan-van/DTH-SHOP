# Copy this file to backend/.env.atlas.local on the PC that has the local product records.
# NEVER commit .env.atlas.local and NEVER paste the completed URI in a chat.
# In Atlas: Connect > Drivers. Replace user, encoded password, cluster and db path.
MONGO_ATLAS_URI=mongodb+srv://YOUR_DB_USER:YOUR_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/dth_3d_commerce?retryWrites=true&w=majority
# Local source is mongodb://127.0.0.1:27017/dth_3d_commerce by default.
# Only set this if your PC local MongoDB uses a different localhost port.
# MONGO_LOCAL_URI=mongodb://127.0.0.1:27017/dth_3d_commerce