# Copy to backend/.env. Separate database from the original repository.
MONGO_URI=mongodb://127.0.0.1:27017/dth_3d_commerce
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
SHOP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5000,http://127.0.0.1:5000
# Optional admin: use a unique TEST password, 12-128 characters; never a real password.
# SHOP_ADMIN_EMAIL=admin@example.test
# SHOP_ADMIN_PASSWORD=YOUR_UNIQUE_TEST_PASSWORD
# Remove the seed password after creating the admin. Never commit .env.
